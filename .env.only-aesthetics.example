# Only Aesthetic — env for Vercel / Render / Railway (NOT CivicLens project)

PRODUCT_SURFACE="aesthetics"

DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"
SESSION_SECRET="paste-openssl-rand-base64-32"

NEXT_PUBLIC_SITE_URL="https://onlyaesthetic.in"

COMMERCE_ADMIN_EMAIL="yash.shah.lp2@gmail.com"
COMMERCE_ADMIN_PASSWORD="choose-a-strong-password"
COMMERCE_ADMIN_REQUIRE_OTP="true"
COMMERCE_ADMIN_NAME="Yash Shah"

ALLOW_DEMO_OTP="false"
INDIA_ONLY_STOREFRONT="true"

RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="..."
# Razorpay Dashboard → Webhooks → payment.captured → this secret
RAZORPAY_WEBHOOK_SECRET=""

# Mobile OTP — MSG91 (required for real SMS login on Only Aesthetic)
SMS_PROVIDER="msg91"
SMS_API_KEY="your-msg91-auth-key"
SMS_SENDER_ID="ONLYAE"
# Temporary testing without MSG91: ALLOW_DEMO_OTP=true and use code 123456

RESEND_API_KEY="re_..."
# Customer care inbox — contact homepage, footer, policies, refunds
COMMERCE_SUPPORT_EMAIL="customercare@onlyaesthetic.in"
SUPPORT_EMAIL_TO="customercare@onlyaesthetic.in"
SUPPORT_REPLY_TO="customercare@onlyaesthetic.in"
# From address for Resend (verify domain onlyaesthetic.in in Resend)
COMMERCE_FROM_EMAIL="Only Aesthetic <customercare@onlyaesthetic.in>"
RESEND_FROM_EMAIL="Only Aesthetic <customercare@onlyaesthetic.in>"

BLOB_READ_WRITE_TOKEN=""

# Delivery — Shiprocket (India). See docs/DELIVERY_SHIPROCKET.md
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_WEBHOOK_SECRET=""
# SHIPROCKET_DEFAULT_WEIGHT_KG="0.5"

# Optional Cloudflare R2 (non-Vercel hosts)
# S3_BUCKET="only-aesthetic"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_PUBLIC_URL="https://pub-xxxxx.r2.dev"
# S3_REGION="auto"
