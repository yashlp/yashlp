# Only Aesthetic — env for Vercel / Render / Railway (NOT CivicLens project)

PRODUCT_SURFACE="aesthetics"

DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"
SESSION_SECRET="paste-openssl-rand-base64-32"

NEXT_PUBLIC_SITE_URL="https://onlyaesthetic.in"

COMMERCE_ADMIN_EMAIL="yash.shah.lp2@gmail.com"
COMMERCE_ADMIN_PASSWORD="choose-a-strong-password"
COMMERCE_ADMIN_REQUIRE_OTP="true"
COMMERCE_ADMIN_NAME="Yash Shah"

ALLOW_DEMO_OTP="false"
INDIA_ONLY_STOREFRONT="true"

RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="..."

RESEND_API_KEY="re_..."
# From address for Resend (can stay Gmail-reply via Reply-To = support_email in admin)
COMMERCE_FROM_EMAIL="Only Aesthetic <onboarding@resend.dev>"
RESEND_FROM_EMAIL="Only Aesthetic <onboarding@resend.dev>"

BLOB_READ_WRITE_TOKEN=""

# Delivery — Shiprocket (India). See docs/DELIVERY_SHIPROCKET.md
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_WEBHOOK_SECRET=""
# SHIPROCKET_DEFAULT_WEIGHT_KG="0.5"

