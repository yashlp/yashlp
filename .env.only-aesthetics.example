# Only Aesthetics — Vercel env (DO NOT put these on CivicLens / yashlp project)

# Create a NEW Vercel project named: only-aesthetics
# Connect the SAME GitHub repo (yashlp/yashlp), Production branch: main
# Add these variables ONLY to that new project.

PRODUCT_SURFACE="aesthetics"

DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"
SESSION_SECRET="paste-openssl-rand-base64-32"

NEXT_PUBLIC_SITE_URL="https://onlyaesthetics.in"

COMMERCE_ADMIN_EMAIL="you@example.com"
COMMERCE_ADMIN_PASSWORD="choose-a-strong-password"
COMMERCE_ADMIN_REQUIRE_OTP="true"
COMMERCE_ADMIN_NAME="Yash Shah"

ALLOW_DEMO_OTP="false"
# Never enable in production:
# ALLOW_DEMO_PAYMENT="true"
# SEED_DEMO_CATALOG="true"

INDIA_ONLY_STOREFRONT="true"

RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="..."

RESEND_API_KEY="re_..."
COMMERCE_FROM_EMAIL="Only Aesthetics <hello@onlyaesthetics.in>"
RESEND_FROM_EMAIL="Only Aesthetics <hello@onlyaesthetics.in>"

BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# One-time only, then delete after one successful deploy:
# PURGE_DEMO_CATALOG="true"
