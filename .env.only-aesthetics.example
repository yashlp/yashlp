# Only Aesthetics — env for Render / Railway / Fly (NOT CivicLens Vercel project)

PRODUCT_SURFACE="aesthetics"

DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"
SESSION_SECRET="paste-openssl-rand-base64-32"

NEXT_PUBLIC_SITE_URL="https://onlyaesthetics.in"

COMMERCE_ADMIN_EMAIL="you@example.com"
COMMERCE_ADMIN_PASSWORD="choose-a-strong-password"
COMMERCE_ADMIN_REQUIRE_OTP="true"
COMMERCE_ADMIN_NAME="Yash Shah"

ALLOW_DEMO_OTP="false"
INDIA_ONLY_STOREFRONT="true"

RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET="..."

RESEND_API_KEY="re_..."
COMMERCE_FROM_EMAIL="Only Aesthetics <hello@onlyaesthetics.in>"
RESEND_FROM_EMAIL="Only Aesthetics <hello@onlyaesthetics.in>"

# Cloudflare R2 (free) — preferred when not using Vercel
S3_BUCKET="only-aesthetics"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_PUBLIC_URL="https://pub-xxxxx.r2.dev"
S3_REGION="auto"

# Optional Vercel-only:
# BLOB_READ_WRITE_TOKEN=""

# One-time purge, then remove:
# PURGE_DEMO_CATALOG="true"
