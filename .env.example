# Database — SQLite locally, PostgreSQL in production (Neon / Vercel Postgres)
DATABASE_URL="file:./dev.db"

# Session signing — REQUIRED in production (min 32 random characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET="civiclens-dev-secret-change-in-production"

# Admin phones (comma-separated, E.164). These users get /admin access on login.
ADMIN_PHONES="+919558812335"

# Demo live site: allow OTP 123456 when SMS is not configured (disable after MSG91 is wired)
ALLOW_DEMO_OTP="true"

# Public site URL (used for SEO metadata and sitemap)
NEXT_PUBLIC_SITE_URL="https://onlyaesthetic.in"

# India-only storefront in production (Vercel geo header). Set false to allow all countries.
INDIA_ONLY_STOREFRONT="true"
# Bypass geo block for testing outside India
# ALLOW_NON_INDIA_ACCESS="true"

# SMS OTP + order/delivery alerts — MSG91 (India). See docs/MOBILE_OTP_MSG91.md
SMS_PROVIDER="msg91"
SMS_API_KEY=""
SMS_SENDER_ID="ONLYAE"
SMS_FLOW_OTP=""
SMS_FLOW_ORDER_CONFIRM=""
SMS_FLOW_SHIPPED=""
SMS_FLOW_OUT_FOR_DELIVERY=""
SMS_FLOW_DELIVERED=""
SMS_FLOW_DELIVERY_UPDATE=""
COMMERCE_ADMIN_PHONE=""

# Payments — Razorpay (India: UPI, cards, netbanking). Money settles to your Razorpay-linked bank account.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Payments — Stripe (international USD cards). Money settles to your Stripe-linked bank account.
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""

# OpenAI — smarter Ask AI (optional; falls back to rules without key)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Resend — order confirmation + signup OTP emails
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Only Aesthetic <customercare@onlyaesthetic.in>"
COMMERCE_FROM_EMAIL="Only Aesthetic <customercare@onlyaesthetic.in>"
# Customer contact + refunds inbox (shown on homepage, footer, policies)
COMMERCE_SUPPORT_EMAIL="customercare@onlyaesthetic.in"
SUPPORT_EMAIL_TO="customercare@onlyaesthetic.in"
SUPPORT_REPLY_TO="customercare@onlyaesthetic.in"

# Cloud photo storage at scale (optional — photos use DB until configured)
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Durable commerce product media uploads (recommended on Vercel)
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Delivery — Shiprocket (India). See docs/DELIVERY_SHIPROCKET.md
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_WEBHOOK_SECRET=""

NODE_ENV="development"

# Aesthetics Commerce — platform admin (/admin/login)
COMMERCE_ADMIN_EMAIL="yash.shah.lp2@gmail.com"
COMMERCE_ADMIN_PASSWORD="your-secure-password"
COMMERCE_ADMIN_REQUIRE_OTP="true"
ALLOW_DEMO_OTP="false"
# ALLOW_DEMO_PAYMENT="false"  # never enable in production
# PURGE_DEMO_CATALOG="true"   # run once on Vercel to remove demo products
# SEED_DEMO_CATALOG="false"   # keep false in production
