# Database (use PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Session signing — REQUIRED in production (min 32 random characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET="civiclens-dev-secret-change-in-production"

# SMS OTP (REQUIRED in production for phone login)
# Without these, OTP send is blocked in production.
SMS_PROVIDER=""
SMS_API_KEY=""

# Node environment
NODE_ENV="development"
