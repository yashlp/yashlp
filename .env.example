# Database — SQLite locally, PostgreSQL in production (Neon / Vercel Postgres)
DATABASE_URL="file:./dev.db"

# Session signing — REQUIRED in production (min 32 random characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET="civiclens-dev-secret-change-in-production"

# Admin phones (comma-separated, E.164). These users get /admin access on login.
ADMIN_PHONES="+919558812335"

# NEVER enable these in production
ALLOW_DEMO_OTP="false"
ALLOW_DEMO_PAYMENTS="false"
SEED_DEMO_USERS="false"

# Public site URL (used for SEO metadata and sitemap)
NEXT_PUBLIC_SITE_URL="https://yashlp.vercel.app"

# SMS OTP — MSG91 (India). When set, real SMS codes are sent to customers.
SMS_PROVIDER="msg91"
SMS_API_KEY=""
SMS_SENDER_ID="CIVCLN"

# Payments — Razorpay (India: UPI, cards, netbanking). Money settles to your Razorpay-linked bank account.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Payments — Stripe (international USD cards). Money settles to your Stripe-linked bank account.
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""

# OpenAI — smarter Ask AI (optional; falls back to rules without key)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Resend — support emails from signed-in users (optional)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CivicLens <onboarding@resend.dev>"
SUPPORT_EMAIL_TO="yash.shah.uk@gmail.com"
SUPPORT_REPLY_TO=""

# Cloud photo storage at scale (optional — photos use DB until configured)
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Durable commerce product media uploads (recommended on Vercel)
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

NODE_ENV="development"

# Aesthetics Commerce — platform admin (/admin/login)
COMMERCE_ADMIN_EMAIL="yash.shah.lp2@gmail.com"
COMMERCE_ADMIN_PASSWORD="your-secure-password"
COMMERCE_ADMIN_REQUIRE_OTP="false"
# Optional: POST { email, code } when admin MFA OTP is generated
COMMERCE_ADMIN_OTP_WEBHOOK=""
# Keep catalog seed on deploy; leave demo users off in production
SEED_COMMERCE_CATALOG="true"
