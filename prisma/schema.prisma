generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  phone            String   @unique
  email            String?
  name             String
  nameChangeCount  Int      @default(0)
  passwordHash     String?
  reputation       Int      @default(0)
  reliabilityScore Float    @default(0.5)
  role             String   @default("user")
  countryCode      String?
  legalProfile     String?
  termsAcceptedAt  DateTime?
  termsVersion     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  incidents        Incident[]         @relation("Reporter")
  confirmations    Confirmation[]
  comments         Comment[]
  resolutionUpdates ResolutionUpdate[]
  timelineEvents   TimelineEvent[]
  savedPlaces      SavedPlace[]
  notifications    Notification[]
  contentDisputes  ContentDispute[]
  reportPurchases  ReportPurchase[]
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Category {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  emoji         String
  type          String
  group         String   @default("")
  photoRequired Boolean  @default(false)
  photoRule     String   @default("optional")
  description   String
  sortOrder     Int      @default(0)
  ttlDays       Int?

  incidents Incident[]
}

model Incident {
  id                 String    @id @default(cuid())
  categoryId         String
  reporterId         String
  title              String
  description        String?
  latitude           Float
  longitude          Float
  address            String?
  countryCode        String?
  status             String    @default("pending")
  visibility         String    @default("hidden")
  visibilityStage    String    @default("private")
  confidenceScore    Float     @default(0.1)
  confirmationCount  Int       @default(0)
  isPositive         Boolean   @default(false)
  aiCategoryMatch    Float?
  aiImageVerified    Boolean?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resolvedAt         DateTime?
  expiresAt          DateTime?
  legalRiskScore     Float?
  underLegalReview   Boolean   @default(false)
  legalFlags         String?
  contentRiskScore   Int?
  complianceAction   String?
  displayLabel       String?
  institutionType    String?
  servicePoint       String?
  corruptionIssueType String?
  aggregationText    String?
  originalDescription String?

  category           Category           @relation(fields: [categoryId], references: [id])
  reporter           User               @relation("Reporter", fields: [reporterId], references: [id])
  confirmations      Confirmation[]
  comments           Comment[]
  timelineEvents     TimelineEvent[]
  resolutionUpdates  ResolutionUpdate[]
  photos             IncidentPhoto[]
  contentDisputes    ContentDispute[]

  @@index([visibilityStage])
  @@index([latitude, longitude])
  @@index([countryCode])
  @@index([createdAt])
}

model IncidentPhoto {
  id             String    @id @default(cuid())
  incidentId     String
  url            String
  caption        String?
  uploadedBy     String
  approvalStatus String    @default("approved")
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime  @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([approvalStatus])
}

model Confirmation {
  id         String   @id @default(cuid())
  incidentId String
  userId     String
  comment    String?
  photoUrl   String?
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([incidentId, userId])
}

model Comment {
  id                  String    @id @default(cuid())
  incidentId          String
  userId              String
  body                String
  photoUrl            String?
  photoApprovalStatus String?
  photoReviewedAt     DateTime?
  photoReviewedBy     String?
  createdAt           DateTime  @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([photoApprovalStatus])
}

model ContentDispute {
  id          String   @id @default(cuid())
  incidentId  String
  userId      String
  reason      String?
  counterEvidence String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([incidentId, userId])
}

model ResolutionUpdate {
  id                String   @id @default(cuid())
  incidentId        String
  userId            String
  description       String?
  photoUrl          String?
  status            String   @default("pending")
  confirmationCount Int      @default(0)
  disputeCount      Int      @default(0)
  createdAt         DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
}

model TimelineEvent {
  id         String   @id @default(cuid())
  incidentId String
  userId     String?
  action     String
  metadata   String?
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])
}

model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  name      String
  latitude  Float
  longitude Float
  radiusM   Int      @default(500)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  metadata  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthScoreSnapshot {
  id             String   @id @default(cuid())
  placeKey       String
  placeName      String
  placeType      String
  latitude       Float
  longitude      Float
  radiusM        Int
  overallScore   Float
  confidence     Float
  categoryScores String
  incidentCount  Int
  computedAt     DateTime @default(now())

  @@index([placeKey])
  @@index([latitude, longitude])
}

/** Runtime config editable from /admin without redeploying */
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model ReportPurchase {
  id                  String    @id @default(cuid())
  userId              String
  productId           String
  latitude            Float
  longitude           Float
  placeName           String?
  amount              Int
  currency            String
  provider            String
  providerOrderId     String?
  providerPaymentId   String?   @unique
  status              String    @default("pending")
  createdAt           DateTime  @default(now())
  paidAt              DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, productId])
  @@index([status])
}

// =============================================================================
// Aesthetics Commerce Platform
// =============================================================================

model CommerceAdmin {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  role            String   @default("ADMIN")
  mfaEnabled      Boolean  @default(false)
  isActive        Boolean  @default(true)
  lastLoginAt     DateTime?
  lastLoginIp     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions        CommerceAdminSession[]
  otps            CommerceAdminOtp[]
  auditLogs       CommerceAuditLog[]
  loginAttempts   CommerceLoginAttempt[]
}

model CommerceAdminSession {
  id          String   @id @default(cuid())
  adminId     String
  tokenHash   String   @unique
  userAgent   String?
  ipAddress   String?
  deviceLabel String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  admin CommerceAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model CommerceAdminOtp {
  id        String   @id @default(cuid())
  adminId   String
  code      String
  purpose   String   @default("login")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  admin CommerceAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model CommerceLoginAttempt {
  id        String   @id @default(cuid())
  adminId   String?
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  reason    String?
  createdAt DateTime @default(now())

  admin CommerceAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([createdAt])
}

model CommerceAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  admin CommerceAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model CommerceSeller {
  id                 String   @id @default(cuid())
  businessName       String
  slug               String   @unique
  email              String   @unique
  phone              String?
  tagline            String?
  instagram          String?
  logoUrl            String?
  status             String   @default("PENDING")
  verified           Boolean  @default(false)
  kycStatus          String   @default("PENDING")
  gstNumber          String?
  commissionPercent  Float    @default(15)
  rating             Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  brands   CommerceBrand[]
  products CommerceProduct[]
  orders   CommerceOrder[]

  @@index([status])
}

model CommerceBrand {
  id        String   @id @default(cuid())
  sellerId  String
  name      String
  slug      String   @unique
  tagline   String?
  logoUrl   String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller   CommerceSeller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products CommerceProduct[]

  @@index([sellerId])
}

model CommerceCategory {
  id          String   @id @default(cuid())
  parentId    String?
  name        String
  slug        String   @unique
  description String?
  icon        String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isFeatured  Boolean  @default(false)
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   CommerceCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children CommerceCategory[] @relation("CategoryTree")
  products CommerceProduct[]

  @@index([parentId])
  @@index([sortOrder])
}

model CommerceProduct {
  id               String   @id @default(cuid())
  sellerId         String
  brandId          String
  categoryId       String
  name             String
  slug             String   @unique
  sku              String?  @unique
  barcode          String?
  shortDescription String?
  description      String
  price            Float
  compareAtPrice   Float?
  mrp              Float?
  taxRate          Float    @default(0)
  gstRate          Float    @default(0)
  stock            Int      @default(0)
  minStock         Int      @default(0)
  maxStock         Int?
  materials        String?
  dimensions       String?
  weight           String?
  countryOfOrigin  String?
  warranty         String?
  returnEligible   Boolean  @default(true)
  specifications   String?
  tags             String?
  mood             String?
  colors           String?
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  status           String   @default("DRAFT")
  approvalStatus   String   @default("PENDING")
  isFeatured       Boolean  @default(false)
  isTrending       Boolean  @default(false)
  isNewArrival     Boolean  @default(false)
  isRecommended    Boolean  @default(false)
  rating           Float    @default(0)
  reviewCount      Int      @default(0)
  publishedAt      DateTime?
  // D2C inventory — Only Aesthetics owns stock
  purchaseCost     Float?
  warehouseLocation String?
  supplierId       String?
  purchaseDate     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  seller       CommerceSeller         @relation(fields: [sellerId], references: [id])
  brand        CommerceBrand          @relation(fields: [brandId], references: [id])
  category     CommerceCategory       @relation(fields: [categoryId], references: [id])
  supplier     CommerceSupplier?      @relation(fields: [supplierId], references: [id])
  media        CommerceProductMedia[]
  variants     CommerceProductVariant[]
  orderItems   CommerceOrderItem[]
  reviews      CommerceReview[]
  collectionItems CommerceCollectionProduct[]

  @@index([sellerId])
  @@index([brandId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([status, approvalStatus])
  @@index([slug])
}

model CommerceProductMedia {
  id        String   @id @default(cuid())
  productId String
  type      String   @default("IMAGE")
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CommerceProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String?
  price     Float?
  stock     Int      @default(0)
  color     String?
  size      String?
  style     String?
  material  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CommerceCollection {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products CommerceCollectionProduct[]

  @@index([isFeatured])
}

model CommerceCollectionProduct {
  id           String @id @default(cuid())
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection CommerceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    CommerceProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
}

model CommerceCustomer {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  passwordHash  String?
  name          String?
  emailVerified Boolean  @default(false)
  status        String   @default("ACTIVE")
  loyaltyPoints Int      @default(0)
  loyaltyLevel  String   @default("STANDARD")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses CommerceCustomerAddress[]
  sessions  CommerceCustomerSession[]
  orders    CommerceOrder[]
  reviews   CommerceReview[]
}

model CommerceCustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  label      String?  @default("Home")
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String   @default("US")
  phone      String?
  isDefault  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer CommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CommerceCustomerSession {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  customer CommerceCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([customerId])
}

model CommerceCustomerPhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([phone])
}

model CommerceCustomerEmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String    @default("SIGNUP")
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model CommerceOrder {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerId      String?
  sellerId        String?
  status          String   @default("PENDING")
  subtotal        Float
  tax             Float    @default(0)
  shipping        Float    @default(0)
  discount        Float    @default(0)
  total           Float
  currency        String   @default("USD")
  customerNotes   String?
  internalNotes   String?
  shippingAddress String?
  trackingNumber  String?
  courier         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer CommerceCustomer? @relation(fields: [customerId], references: [id])
  seller   CommerceSeller?   @relation(fields: [sellerId], references: [id])
  items    CommerceOrderItem[]
  payments CommercePayment[]
  refunds  CommerceRefund[]
  returns  CommerceReturn[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
}

model CommerceOrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  total     Float
  variantId String?

  order   CommerceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product CommerceProduct @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model CommercePayment {
  id                String   @id @default(cuid())
  orderId           String
  amount            Float
  currency          String   @default("USD")
  status            String   @default("PENDING")
  provider          String   @default("stripe")
  providerPaymentId String?
  metadata          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model CommerceRefund {
  id        String   @id @default(cuid())
  orderId   String
  amount    Float
  status    String   @default("PENDING")
  reason    String?
  type      String   @default("FULL")
  timeline  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model CommerceReview {
  id               String   @id @default(cuid())
  productId        String
  customerId       String?
  rating           Int
  title            String?
  body             String?
  status           String   @default("PENDING")
  verifiedPurchase Boolean  @default(false)
  adminReply       String?
  isFeatured       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product  CommerceProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer CommerceCustomer? @relation(fields: [customerId], references: [id])

  @@index([productId])
  @@index([status])
}

model CommerceCoupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String    @default("PERCENT")
  discountValue Float
  minOrderValue Float?
  maxUses       Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  startsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CommerceContent {
  id        String   @id @default(cuid())
  key       String   @unique
  type      String   @default("PAGE")
  title     String?
  body      String?
  imageUrl  String?
  metadata  String?
  isPublished Boolean @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model CommerceSetting {
  key       String   @id
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ─── D2C Operations (Only Aesthetics owns inventory) ─────────────────────────

model CommerceSupplier {
  id               String   @id @default(cuid())
  brandName        String
  slug             String   @unique
  contactPerson    String?
  mobile           String?
  email            String?
  gstNumber        String?
  panNumber        String?
  bankDetails      String?  // JSON: account, ifsc, bank name
  productCategories String? // JSON array of category slugs
  documents        String?  // JSON array of document URLs
  address          String?
  notes            String?
  status           String   @default("ACTIVE")
  outstandingBalance Float @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products       CommerceProduct[]
  purchaseOrders CommercePurchaseOrder[]

  @@index([status])
}

model CommercePurchaseOrder {
  id               String   @id @default(cuid())
  poNumber         String   @unique
  supplierId       String
  status           String   @default("DRAFT")
  paymentStatus    String   @default("PENDING")
  orderDate        DateTime @default(now())
  expectedDelivery DateTime?
  invoiceNumber    String?
  invoiceUrl       String?
  subtotal         Float    @default(0)
  tax              Float    @default(0)
  total            Float    @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier CommerceSupplier            @relation(fields: [supplierId], references: [id])
  lines    CommercePurchaseOrderLine[]

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
}

model CommercePurchaseOrderLine {
  id                String  @id @default(cuid())
  purchaseOrderId   String
  productId         String?
  sku               String?
  name              String
  quantityOrdered   Int
  quantityReceived  Int     @default(0)
  quantityDamaged   Int     @default(0)
  unitCost          Float
  total             Float

  purchaseOrder CommercePurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model CommerceReturn {
  id          String   @id @default(cuid())
  orderId     String
  status      String   @default("REQUESTED")
  type        String   @default("REFUND")
  reason      String?
  condition   String?
  refundAmount Float?
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

